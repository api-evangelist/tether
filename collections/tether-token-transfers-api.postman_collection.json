    {
      "id": "7f77eef6-9a91-4451-952e-2d7cc8e8007a",
      "name": "Token Transfers",
      "description": {
        "content": "Query token transfer history for addresses",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "7411ae2c-98b6-46be-8c66-ec41726876eb",
          "name": "Get token transfers for an address",
          "request": {
            "name": "Get token transfers for an address",
            "description": {
              "content": "Retrieve the token transfer history for a specific wallet address on a given blockchain. Returns incoming and outgoing transfers sorted by block number.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                ":blockchain",
                ":token",
                ":address",
                "token-transfers"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "10",
                  "description": "Maximum number of transfers to return."
                },
                {
                  "disabled": false,
                  "key": "fromTs",
                  "value": "0",
                  "description": "Start timestamp in milliseconds (inclusive). Use 0 to query from the beginning."
                },
                {
                  "disabled": false,
                  "key": "toTs",
                  "value": "<integer>",
                  "description": "End timestamp in milliseconds (inclusive). Omit to query up to the latest available data."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "blockchain",
                  "description": "(Required) Blockchain network identifier. Use GET /api/v1/chains to see all available options."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "token",
                  "description": "(Required) Token identifier. Must be a valid token for the specified blockchain."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "address",
                  "description": "(Required) Wallet address to query. Format varies by blockchain (e.g. 0x... for EVM, bc1... for Bitcoin, T... for Tron)."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-API-KEY"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
