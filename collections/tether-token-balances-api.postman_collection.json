        {
          "id": "94b1d409-6963-4970-8021-bc92f3cc7607",
          "name": "Get token balance for an address",
          "request": {
            "name": "Get token balance for an address",
            "description": {
              "content": "Retrieve the current token balance for a specific wallet address on a given blockchain. Returns a single balance amount representing how much of the specified token the address currently holds.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                ":blockchain",
                ":token",
                ":address",
                "token-balances"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "blockchain",
                  "description": "(Required) Blockchain network identifier. Use GET /api/v1/chains to see all available options."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "token",
                  "description": "(Required) Token identifier. Must be a valid token for the specified blockchain."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "address",
                  "description": "(Required) Wallet address to query. Format varies by blockchain (e.g. 0x... for EVM, bc1... for Bitcoin, T... for Tron)."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
